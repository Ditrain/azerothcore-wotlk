+#
+#   LLMChatter.OpenAI.BaseUrl
+#       Optional OpenAI-compatible API base URL. Leave empty for OpenAI.
+#       Example for LM Studio: http://192.168.1.10:1234/v1
+#
+LLMChatter.OpenAI.BaseUrl =
+
+#
+#   LLMChatter.OpenAI.ReasoningEffort
+#       Optional OpenAI-compatible reasoning effort. Leave empty to omit.
+#       LM Studio reasoning models may accept "none" for short chatter.
+#
+LLMChatter.OpenAI.ReasoningEffort =
+
