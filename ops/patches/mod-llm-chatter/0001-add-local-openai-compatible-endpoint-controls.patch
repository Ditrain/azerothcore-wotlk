+def _openai_client_kwargs(config):
+    """Build OpenAI client options, including compatible endpoints."""
+    kwargs = {
+        'api_key': config.get('LLMChatter.OpenAI.ApiKey', ''),
+    }
+    base_url = str(config.get(
+        'LLMChatter.OpenAI.BaseUrl', ''
+    )).strip()
+    if base_url:
+        kwargs['base_url'] = base_url
+    return kwargs
+
+
+def _apply_openai_options(kwargs, config):
+    """Attach optional OpenAI-compatible reasoning controls."""
+    effort = str(config.get(
+        'LLMChatter.OpenAI.ReasoningEffort', ''
+    )).strip().lower()
+    if effort and effort not in ('0', 'off', 'disabled'):
+        kwargs['reasoning_effort'] = effort
+
