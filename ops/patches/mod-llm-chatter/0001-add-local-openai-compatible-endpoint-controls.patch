diff --git a/tools/tests/test_openai_compatible_endpoint.py b/tools/tests/test_openai_compatible_endpoint.py
new file mode 100644
index 0000000..8d60189
--- /dev/null
+++ b/tools/tests/test_openai_compatible_endpoint.py
@@ -0,0 +1,195 @@
+#!/usr/bin/env python3
+"""Focused OpenAI-compatible endpoint and reasoning checks."""
+
+import json
+import os
+import base64
+import re
+import sys
+import types
+from pathlib import Path
+
+
+TOOLS_DIR = Path(__file__).resolve().parents[1]
+if str(TOOLS_DIR) not in sys.path:
+    sys.path.insert(0, str(TOOLS_DIR))
+
+import chatter_llm  # noqa: E402
+
+
+class _PromptParts(str):
+    system_prompt = None
+    user_prompt = ''
+
+
+_shared_stub = types.ModuleType('chatter_shared')
+_shared_stub.PromptParts = _PromptParts
+sys.modules['chatter_shared'] = _shared_stub
+
+
+class _Message:
+    content = '{"message":"Ready","emote":null,"action":null}'
+    tool_calls = None
+
+
+class _Choice:
+    message = _Message()
+    finish_reason = 'stop'
+
+
+class _Response:
+    choices = [_Choice()]
+
+
+class _Completions:
+    def __init__(self):
+        self.kwargs = None
+
+    def create(self, **kwargs):
+        self.kwargs = kwargs
+        return _Response()
+
+
+class _Chat:
+    def __init__(self):
+        self.completions = _Completions()
+
+
+class _Client:
+    def __init__(self):
+        self.chat = _Chat()
+
+
+def test_openai_client_kwargs_support_compatible_base_url():
+    kwargs = chatter_llm._openai_client_kwargs({
+        'LLMChatter.OpenAI.ApiKey': 'lm-studio',
+        'LLMChatter.OpenAI.BaseUrl': 'http://127.0.0.1:1234/v1',
+    })
+    assert kwargs == {
+        'api_key': 'lm-studio',
+        'base_url': 'http://127.0.0.1:1234/v1',
+    }
+
+
+def test_none_reasoning_effort_is_sent():
+    kwargs = {}
+    chatter_llm._apply_openai_options(kwargs, {
+        'LLMChatter.OpenAI.ReasoningEffort': 'none',
+    })
+    assert kwargs['reasoning_effort'] == 'none'
+
+
+def test_empty_or_off_reasoning_effort_is_omitted():
+    for value in ('', 'off', 'disabled', '0'):
+        kwargs = {}
+        chatter_llm._apply_openai_options(kwargs, {
+            'LLMChatter.OpenAI.ReasoningEffort': value,
+        })
+        assert 'reasoning_effort' not in kwargs
+
+
+def test_main_and_quick_calls_send_reasoning_effort():
+    config = {
+        'LLMChatter.Provider': 'openai',
+        'LLMChatter.Model': 'qwen/qwen3.5-9b',
+        'LLMChatter.OpenAI.ReasoningEffort': 'none',
+        'LLMChatter.MaxTokens': 120,
+        'LLMChatter.Temperature': 0.7,
+    }
+
+    main_client = _Client()
+    result = chatter_llm.call_llm(
+        main_client, 'Say hello.', config,
+        label='compat_test',
+    )
+    assert result.startswith('{"message"')
+    assert (
+        main_client.chat.completions.kwargs['reasoning_effort']
+        == 'none'
+    )
+
+    quick_client = _Client()
+    result = chatter_llm.quick_llm_analyze(
+        quick_client, config, 'Classify this.',
+        label='compat_quick_test',
+    )
+    assert result.startswith('{"message"')
+    assert (
+        quick_client.chat.completions.kwargs['reasoning_effort']
+        == 'none'
+    )
+
+
+def live_lmstudio_smoke():
+    config = {
+        'LLMChatter.Provider': 'openai',
+        'LLMChatter.Model': 'qwen/qwen3.5-9b',
+        'LLMChatter.OpenAI.ApiKey': 'lm-studio',
+        'LLMChatter.OpenAI.BaseUrl': 'http://127.0.0.1:1234/v1',
+        'LLMChatter.OpenAI.ReasoningEffort': 'none',
+        'LLMChatter.MaxTokens': 120,
+        'LLMChatter.Temperature': 0.7,
+    }
+    client = chatter_llm.get_llm_client(config)
+    result = chatter_llm.call_llm(
+        client,
+        (
+            'Return only JSON with keys message, emote, and action. '
+            'Write one grounded fantasy greeting from Branna, a weary '
+            'dwarven scout, to Rowan. Use null for emote and action.'
+        ),
+        config,
+        label='live_lmstudio_compat_test',
+    )
+    match = re.search(r'\{.*\}', result, re.DOTALL)
+    assert match is not None
+    parsed = json.loads(match.group())
+    assert set(parsed) == {'message', 'emote', 'action'}
+    assert parsed['message']
+    assert parsed['emote'] is None
+    assert parsed['action'] is None
+
+
+def live_lmstudio_vision_smoke():
+    import openai
+    import screenshot_agent
+
+    client = openai.OpenAI(
+        api_key='lm-studio',
+        base_url='http://127.0.0.1:1234/v1',
+    )
+    image_path = TOOLS_DIR.parent / 'icon.png'
+    image_b64 = base64.standard_b64encode(
+        image_path.read_bytes()
+    ).decode()
+    result = screenshot_agent._call_openai(
+        image_b64,
+        client,
+        'qwen/qwen3.5-9b',
+        reasoning_effort='none',
+    )
+    match = re.search(r'\{.*\}', result, re.DOTALL)
+    assert match is not None
+    parsed = json.loads(match.group())
+    known_fields = {
+        'landmark_type', 'weather', 'time_of_day', 'biome',
+        'atmosphere', 'environment', 'creatures',
+        'interesting', 'skip_reason',
+    }
+    assert known_fields.intersection(parsed)
+
+
+def main() -> int:
+    test_openai_client_kwargs_support_compatible_base_url()
+    test_none_reasoning_effort_is_sent()
+    test_empty_or_off_reasoning_effort_is_omitted()
+    test_main_and_quick_calls_send_reasoning_effort()
+    if os.environ.get('LIVE_LMSTUDIO') == '1':
+        live_lmstudio_smoke()
+        live_lmstudio_vision_smoke()
+    print('OK')
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
