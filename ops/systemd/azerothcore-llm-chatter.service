[Unit]
Description=AzerothCore LLM Chatter Bridge
After=mysql.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ditrain
Group=ditrain
WorkingDirectory=/mnt/data/wow-server/source/modules/mod-llm-chatter/tools
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/mnt/data/wow-server/runtime/mod-llm-chatter/venv/bin/python /mnt/data/wow-server/source/modules/mod-llm-chatter/tools/llm_chatter_bridge.py --config /mnt/data/wow-server/source/env/dist/etc/modules/mod_llm_chatter.conf
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
RestrictSUIDSGID=true
